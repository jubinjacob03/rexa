# Shantha - Personal Assistant Configuration
# Discord Bot Credentials
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_guild_id_here

# AI API Keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_GENERATIVE_AI_API_KEY=your_api_key_here

# AI Model Configuration
AI_MODEL_PROVIDER=openrouter
AI_MODEL_NAME=nvidia/nemotron-3-super-120b-a12b:free
AI_MODEL_PRESET=fast
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4000

# Supabase (for RAG/Knowledge Base)
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# Server Monitoring Settings
STATUS_CHANNEL_ID=your_status_channel_id_here

# Update interval in minutes (default: 5)
UPDATE_INTERVAL=5

# Verification System
VERIFICATION_CHANNEL_ID=your_verification_channel_id_here
APPROVALS_CHANNEL_ID=your_approvals_channel_id_here

# Roles
UNVERIFIED_ROLE_ID=your_unverified_role_id_here
FRIENDS_ROLE_ID=your_friends_role_id_here
MEMBER_ROLE_ID=your_member_role_id_here
MODERATOR_ROLE_ID=your_moderator_role_id_here
MANAGER_ROLE_ID=your_manager_role_id_here
OWNER_ROLE_ID=your_owner_role_id_here
BOT_ROLE_ID=your_bot_role_id_here
